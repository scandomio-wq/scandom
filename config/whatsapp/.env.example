# Configuration Twilio WhatsApp
# Copiez ce fichier vers .env et remplissez avec vos valeurs réelles
# IMPORTANT: Ne jamais commiter le fichier .env dans le dépôt Git

# Identifiants Twilio (disponibles sur https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numéro WhatsApp Twilio (format: +1234567890)
TWILIO_WHATSAPP_NUMBER=+1234567890

# URLs des webhooks (utilisez ngrok pour le développement local)
TWILIO_WEBHOOK_URL=https://votre-domaine.ngrok-free.dev/api/whatsapp/twilio
TWILIO_WEBHOOK_STATUS_URL=https://votre-domaine.ngrok-free.dev/api/whatsapp/status
